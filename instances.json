{
  "odoo_configs": {
    "18.0_default": {
      "enabled": true,
      "admin_password": "admin",
      "workers": 2,
      "without_demo": true,
      "list_db": true,
      "proxy_mode": true,
      "server_wide_modules": "",
      "addons": [
        "src/enterprise"
      ]
    }
  },
  "databases": {
    "db_prueba": {
      "postgres_version": 16,
      "port": 5432,
      "expose_host_port": false,
      "user": "odoo",
      "password": "odoo",
      "config": "postgresql.small.conf",
      "create_container": true
    }
  },
  "instances": {
    "prueba_tecnica": {
      "enabled": true,
      "odoo_version": "18.0",
      "external_port": 8069,
      "database": "db_prueba",
      "odoo_config": "18.0_default",
      "overwrite_odoo_config": {
        "dev_mode": true,
        "db_name": false,
        "db_filter": "^(prueba_limpia|dev_ej1_shop|dev_ej2_fleet|dev_ej3_pos|dev_ej4_maint)$",
        "addons": [
          "src/enterprise",
          "src/custom"
        ]
      }
    }
  },
  "pgadmin": {
    "enabled": false
  }
}
