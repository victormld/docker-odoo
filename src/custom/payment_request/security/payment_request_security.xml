<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_payment_request" model="ir.module.category">
        <field name="name">Payment Requests</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_payment_request_user" model="res.groups">
        <field name="name">Requester</field>
        <field name="category_id" ref="module_category_payment_request"/>
    </record>

    <record id="group_payment_request_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_payment_request_treasury" model="res.groups">
        <field name="name">Treasury</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Any employee can request a payment: every internal user is a requester -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <record id="payment_request_rule_own" model="ir.rule">
        <field name="name">Payment requests: requesters see their own</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <record id="payment_request_rule_all" model="ir.rule">
        <field name="name">Payment requests: approvers and treasury see all</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_approver')), (4, ref('group_payment_request_treasury'))]"/>
    </record>

    <record id="payment_request_rule_company" model="ir.rule">
        <field name="name">Payment requests: multi-company</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
