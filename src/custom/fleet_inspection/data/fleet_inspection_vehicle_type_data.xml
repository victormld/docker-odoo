<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The codes match the keys of the former vehicle_type selection field -->
    <record id="vehicle_type_motorcycle" model="fleet.inspection.vehicle.type">
        <field name="name">Motorcycle</field>
        <field name="code">motorcycle</field>
        <field name="sequence">10</field>
    </record>
    <record id="vehicle_type_car" model="fleet.inspection.vehicle.type">
        <field name="name">Car</field>
        <field name="code">car</field>
        <field name="sequence">20</field>
    </record>
    <record id="vehicle_type_truck" model="fleet.inspection.vehicle.type">
        <field name="name">Truck</field>
        <field name="code">truck</field>
        <field name="sequence">30</field>
    </record>
    <record id="vehicle_type_other" model="fleet.inspection.vehicle.type">
        <field name="name">Other</field>
        <field name="code">other</field>
        <field name="sequence">40</field>
    </record>
</odoo>
