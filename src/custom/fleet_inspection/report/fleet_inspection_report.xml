<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_fleet_inspection" model="ir.actions.report">
        <field name="name">Inspection</field>
        <field name="model">fleet.inspection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fleet_inspection.report_fleet_inspection</field>
        <field name="report_file">fleet_inspection.report_fleet_inspection</field>
        <field name="print_report_name">'Inspection - %s' % object.name</field>
        <field name="binding_model_id" ref="model_fleet_inspection"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_fleet_inspection">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Inspection <span t-esc="o.name"/></h2>
                        <p>
                            <strong>Vehicle:</strong> <span t-esc="o.vehicle_id.display_name"/><br/>
                            <strong>Type:</strong> <span t-field="o.vehicle_type"/><br/>
                            <strong>Inspector:</strong> <span t-esc="o.inspector_id.name"/><br/>
                            <strong>Date:</strong> <span t-field="o.date"/><br/>
                            <strong>Status:</strong> <span t-field="o.state"/>
                        </p>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Point</th><th>Result</th><th>Comment</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-esc="line.item_id.name"/></td>
                                    <td><span t-field="line.result"/></td>
                                    <td><span t-esc="line.comment"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-if="o.notes"><strong>Notes:</strong> <span t-esc="o.notes"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
