<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_request_payment_wizard_view_form" model="ir.ui.view">
        <field name="name">payment.request.payment.wizard.form</field>
        <field name="model">payment.request.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay Payment Request">
                <field name="request_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="amount"/>
                    </group>
                    <group>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="payment_date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_pay" string="Register Payment" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
